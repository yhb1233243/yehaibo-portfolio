---
import { getCollection } from "astro:content";
import PageFrame from "../../layouts/PageFrame.astro";
import { estimateReadingMinutes, formatEssayDate } from "../../lib/essays";

const essays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const description = "记录技术、成长与日常里的思考。叶海波的个人随笔。";
---

<PageFrame title="随笔 · 叶海波" description={description}>
  <section aria-labelledby="essays-title">
    <a href="/#home" class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-white/40 transition-colors hover:text-cyan-300"><span aria-hidden="true">←</span> 返回主页</a>
    <div class="mt-8 max-w-2xl">
      <p class="eyebrow">Notes &amp; Reflections</p>
      <h1 id="essays-title" class="section-title mt-5">随笔</h1>
      <p class="mt-5 text-sm leading-8 text-muted sm:text-base">记录技术、成长与日常里的思考。写下当下的困惑、灵感和答案，也给未来的自己留一封信。</p>
    </div>

    {
      essays.length ? (
        <div class="mt-12 space-y-4">
          {essays.map((essay, index) => (
            <a href={`/essays/${essay.id}/`} class="glass glass-hover group grid gap-5 p-5 sm:grid-cols-[110px_minmax(0,1fr)_auto] sm:items-center sm:p-7">
              <div>
                <p class="font-mono text-[10px] text-violet-300/75">NOTE / {String(index + 1).padStart(2, "0")}</p>
                <time class="mt-2 block font-mono text-[10px] leading-5 text-white/35" datetime={essay.data.publishedAt.toISOString()}>{formatEssayDate(essay.data.publishedAt)}</time>
              </div>
              <div>
                <h2 class="font-display text-lg font-semibold text-white transition-colors group-hover:text-cyan-200 sm:text-xl">{essay.data.title}</h2>
                <p class="mt-2 text-sm leading-7 text-muted">{essay.data.summary}</p>
                <div class="mt-3 flex flex-wrap gap-2">{essay.data.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
              </div>
              <span class="hidden items-center gap-2 font-mono text-[10px] text-white/40 sm:flex">{estimateReadingMinutes(essay.body)} 分钟 <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      ) : (
        <div class="glass mt-12 p-7 sm:p-10">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-violet-300/75">No entries yet</p>
          <h2 class="mt-4 font-display text-xl font-semibold text-white">这里还没有公开的随笔。</h2>
          <p class="mt-3 max-w-xl text-sm leading-7 text-muted">你可以在 <code class="rounded bg-white/[0.07] px-1.5 py-1 font-mono text-xs text-cyan-200">src/content/essays/</code> 新建 Markdown 文件，写下想记录的感悟；将 frontmatter 中的 <code class="rounded bg-white/[0.07] px-1.5 py-1 font-mono text-xs text-cyan-200">draft</code> 设为 <code class="rounded bg-white/[0.07] px-1.5 py-1 font-mono text-xs text-cyan-200">false</code> 后就会发布。</p>
        </div>
      )
    }
  </section>
</PageFrame>
