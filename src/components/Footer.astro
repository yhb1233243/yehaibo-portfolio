---
import { siteConfig } from "../config";

const homePrefix = Astro.url.pathname === "/" ? "" : "/";
---

<footer class="mt-28 border-t border-white/[0.09] py-8 sm:mt-36 sm:py-10">
  <div class="flex flex-col gap-7 sm:flex-row sm:items-center sm:justify-between">
    <a href={`${homePrefix}#home`} class="flex items-center gap-3">
      <span class="grid h-9 w-9 place-items-center rounded-xl border border-white/20 bg-gradient-to-br from-violet-500/80 to-cyan-400/70 font-display text-sm font-bold text-white">叶</span>
      <span>
        <span class="block font-display text-sm font-semibold text-white">{siteConfig.name}</span>
        <span class="mt-0.5 block font-mono text-[9px] uppercase tracking-[0.18em] text-white/35">Build · Ship · Learn</span>
      </span>
    </a>

    <nav class="flex flex-wrap gap-5 font-mono text-[10px] uppercase tracking-[0.14em] text-white/40" aria-label="页脚导航">
      <a href={`${homePrefix}#home`} class="transition-colors hover:text-white">Home</a>
      <a href={`${homePrefix}#projects`} class="transition-colors hover:text-white">Projects</a>
      <a href={`${homePrefix}#experience`} class="transition-colors hover:text-white">Experience</a>
      <a href="/essays/" class="transition-colors hover:text-white">Essays</a>
      <a href={`${homePrefix}#achievements`} class="transition-colors hover:text-white">Proof</a>
      <a href={`${homePrefix}#about`} class="transition-colors hover:text-white">About</a>
    </nav>

      {
        siteConfig.social.email && (
          <a href={`mailto:${siteConfig.social.email}`} class="font-mono text-[10px] text-cyan-300/75 transition-colors hover:text-cyan-200">{siteConfig.social.email}</a>
        )
      }
      {
        siteConfig.social.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 font-mono text-[10px] text-white/45 transition-colors hover:text-cyan-300" aria-label="GitHub 个人主页">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.71 2.63 1.22 3.27.93.1-.72.39-1.22.71-1.5-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.11-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.24-5.1 5.52.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" /></svg>
            GitHub
          </a>
        )
      }
  </div>
  <div class="mt-8 flex flex-col gap-2 border-t border-white/[0.06] pt-5 font-mono text-[9px] uppercase tracking-[0.16em] text-white/25 sm:flex-row sm:justify-between">
    <span>© {new Date().getFullYear()} {siteConfig.name}</span>
    <span>Designed &amp; built with Astro · Tailwind CSS</span>
  </div>
</footer>
