---
import { siteConfig } from "../config";

const featured = siteConfig.projects[0];
const stats = [
  { value: String(siteConfig.projects.length).padStart(2, "0"), label: "代表项目" },
  { value: String(siteConfig.experience.length).padStart(2, "0"), label: "实践经历" },
  { value: String(siteConfig.skills.length).padStart(2, "0"), label: "技术能力" },
  { value: "∞", label: "持续学习" },
];

const focusItems = ["RAG 混合检索", "Agent 工作流", "全栈交付"];
---

<section id="home" class="relative pt-28 sm:pt-32 lg:pt-28">
  <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.94fr)_minmax(0,1.06fr)] lg:gap-4">
    <div class="relative z-10 max-w-[620px]" data-reveal style="--delay: 80ms">
      <span class="badge">AI Agent Engineer</span>

      <h1 class="mt-7 font-display text-[clamp(2.7rem,6vw,4.7rem)] font-semibold leading-[1.12] text-white">
        <span class="block">把大模型，变成</span>
        <span class="text-gradient block">可靠的 AI 产品。</span>
      </h1>

      <p class="mt-6 max-w-[540px] text-[15px] leading-8 text-muted sm:text-base">
        我是叶海波，广西师范大学软件工程硕士。专注 RAG 检索、Agent 编排与全栈交付；核心参与的思政 AI 助教平台已上线并接入桂教通。
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class="btn btn-primary">
          查看代表项目
          <span aria-hidden="true" class="text-base">→</span>
        </a>
        {
          siteConfig.social.email && (
            <a href={`mailto:${siteConfig.social.email}`} class="btn btn-ghost">
              邮件联系
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </a>
          )
        }
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.2em] text-dim">
        <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_12px_#34d399]"></span>2027 届 · 可实习</span>
        <span class="text-white/20">/</span>
        <span>RAG</span>
        <span>Agent</span>
        <span>MCP</span>
      </div>
    </div>

    <div class="avatar-stage relative" data-parallax-stage data-reveal style="--delay: 180ms">
      <div class="avatar-glow" aria-hidden="true"></div>
      <div class="orbit" aria-hidden="true"></div>
      <div class="orbit orbit--two" aria-hidden="true"></div>
      <div class="holo-platform" aria-hidden="true"></div>

      <img
        src="/images/avatar-3d.webp"
        alt="AI Agent 工程师风格的 3D 人物视觉"
        width="770"
        height="972"
        fetchpriority="high"
        decoding="async"
        data-parallax-avatar
        class="avatar-img"
      />

      <div class="float-card float-card--stack p-3.5">
        <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-white/45">Core stack</p>
        <div class="mt-3 space-y-2.5 font-mono text-[11px] text-white/80">
          <p class="flex items-center gap-2"><span class="text-cyan-300">✦</span> LLM</p>
          <p class="flex items-center gap-2"><span class="text-violet-300">◈</span> Agent</p>
          <p class="flex items-center gap-2"><span class="text-pink-300">◎</span> RAG</p>
          <p class="flex items-center gap-2"><span class="text-emerald-300">⌘</span> MCP</p>
        </div>
      </div>

      <div class="float-card float-card--code p-4">
        <div class="flex items-center gap-1.5 font-mono text-[9px] text-white/40">
          <span class="h-1.5 w-1.5 rounded-full bg-red-400"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          <span class="ml-2">agent.ts</span>
        </div>
        <pre class="mt-3 overflow-hidden font-mono text-[10px] leading-5 text-white/75"><span class="text-violet-300">const</span> agent = <span class="text-cyan-300">new Agent</span>(&#123;
  tools: [<span class="text-emerald-300">"rag"</span>, <span class="text-emerald-300">"mcp"</span>],
  memory: <span class="text-pink-300">true</span>,
&#125;);
<span class="text-cyan-300">await</span> agent.run(<span class="text-emerald-300">"ship"</span>);</pre>
      </div>

      <span class="status-pill absolute bottom-16 left-[8%] z-10">Research → Production</span>
      <span class="vertical-tag">RAG · AGENT · FULL STACK</span>
    </div>
  </div>

  <div class="mt-10 grid grid-cols-12 gap-4 sm:gap-5">
    <div class="glass glass-hover col-span-12 p-5 md:col-span-6 lg:col-span-4" data-reveal style="--delay: 100ms">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow">Toolkit</p>
          <h2 class="mt-3 font-display text-xl font-semibold text-white">我的技能</h2>
        </div>
        <a href="#about" class="pt-1 font-mono text-[10px] text-white/45 transition-colors hover:text-cyan-300">全部 →</a>
      </div>
      <p class="mt-2 text-xs leading-6 text-muted">从模型调用到生产部署，覆盖完整交付链路。</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {siteConfig.skills.map((skill) => <span class="chip">{skill}</span>)}
      </div>
    </div>

    <div class="glass glass-hover col-span-12 p-0 md:col-span-6 lg:col-span-4" data-reveal style="--delay: 150ms">
      <div class="terminal h-full">
        <div class="terminal__bar flex items-center gap-1.5 px-5 py-3">
          <span class="terminal__dot bg-red-400"></span>
          <span class="terminal__dot bg-amber-300"></span>
          <span class="terminal__dot bg-emerald-400"></span>
          <span class="ml-2 text-[10px] text-white/40">~/portfolio</span>
        </div>
        <div class="space-y-1.5 px-5 py-4 text-[11px] leading-5 text-white/70">
          <p class="terminal__line"><span class="terminal__prompt">❯</span> cd <span class="terminal__path">~/ai-agent-portfolio</span></p>
          <p class="terminal__line"><span class="terminal__prompt">❯</span> pnpm build</p>
          <p class="mt-3 text-white/40">Astro v5 · Tailwind v4</p>
          <p><span class="terminal__ok">✓</span> built in 1.1s</p>
          <p class="mt-3"><span class="terminal__prompt">❯</span> pnpm preview</p>
          <p class="text-cyan-300/80">➜ Local: localhost:4321</p>
          <p class="text-emerald-300"><span class="terminal__ok">✓</span> ready<span class="terminal__cursor"></span></p>
        </div>
      </div>
    </div>

    <div class="glass glass-hover col-span-12 p-5 md:col-span-6 lg:col-span-4" data-reveal style="--delay: 200ms">
      <div class="flex items-center justify-between gap-3">
        <p class="eyebrow">Featured Project</p>
        <span class="rounded-full border border-emerald-300/25 bg-emerald-300/10 px-2 py-1 font-mono text-[9px] text-emerald-300">LIVE</span>
      </div>
      <div class="mt-5 flex items-center justify-center rounded-2xl border border-violet-300/15 bg-[radial-gradient(circle_at_50%_50%,rgba(139,92,246,.23),transparent_58%)] py-4">
        <div class="mini-orb"></div>
      </div>
      <h3 class="mt-4 font-display text-lg font-semibold text-white">{featured.name}</h3>
      <p class="mt-2 line-clamp-2 text-xs leading-6 text-muted">RAG 混合检索、知识图谱与 Agent 备课工作流，面向真实教育场景交付。</p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {featured.skills.slice(0, 4).map((skill) => <span class="chip">{skill}</span>)}
      </div>
      {
        featured.link && (
          <a href={featured.link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-xs font-medium text-cyan-300 transition-colors hover:text-white">
            查看线上项目 <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>

    <div class="glass col-span-12 p-5 md:col-span-6 lg:col-span-4" data-reveal style="--delay: 250ms">
      <p class="eyebrow">Numbers</p>
      <div class="mt-6 grid grid-cols-4 divide-x divide-white/10">
        {stats.map((stat) => (
          <div class="px-2 first:pl-0 last:pr-0">
            <p class="stat-number">{stat.value}</p>
            <p class="stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="glass col-span-12 p-5 md:col-span-6 lg:col-span-4" data-reveal style="--delay: 300ms">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow">Now</p>
          <h2 class="mt-3 font-display text-lg font-semibold text-white">广西师范大学 · 硕士</h2>
        </div>
        <span class="mt-1 h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_16px_#34d399]"></span>
      </div>
      <p class="mt-3 text-xs leading-6 text-muted">研究方向：大模型安全、教育智能化，以及如何让 Agent 在真实系统里稳定运行。</p>
      <div class="mt-4 flex flex-wrap gap-2 font-mono text-[10px] text-white/50">
        <span class="chip">2024.09 — 2027.06</span>
        <span class="chip">可实习</span>
      </div>
    </div>

    <div class="glass col-span-12 p-5 md:col-span-6 lg:col-span-4" data-reveal style="--delay: 350ms">
      <p class="eyebrow">Focus</p>
      <div class="mt-4 space-y-3">
        {focusItems.map((item, index) => (
          <div class="flex items-center gap-3 border-b border-white/[0.07] pb-3 last:border-0 last:pb-0">
            <span class="font-mono text-[10px] text-violet-300/70">0{index + 1}</span>
            <span class="text-sm text-white/75">{item}</span>
            <span class="ml-auto text-white/25">↗</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
