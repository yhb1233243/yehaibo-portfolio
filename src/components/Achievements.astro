---
import { siteConfig } from "../config";

const highlights = [
  { value: "2", label: "省级竞赛奖项" },
  { value: "2", label: "软件著作权" },
  { value: "1", label: "国家级职业资格" },
  { value: "2", label: "创新实践项目" },
];
---

<section id="achievements" class="pt-28 sm:pt-36">
  <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="eyebrow">04 / Evidence of Growth</p>
      <h2 class="section-title mt-5">成果与证据</h2>
    </div>
    <p class="max-w-sm text-sm leading-7 text-muted sm:text-right">
      比奖项本身更重要的，是从竞赛、项目到生产系统持续积累的工程能力。
    </p>
  </div>

  <div class="mt-9 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {highlights.map((item) => (
      <div class="glass p-5 sm:p-6">
        <p class="font-display text-3xl font-semibold tracking-tight text-gradient sm:text-4xl">{item.value}</p>
        <p class="mt-3 text-xs leading-5 text-muted">{item.label}</p>
      </div>
    ))}
  </div>

  <div class="mt-5 grid gap-4 lg:grid-cols-2">
    {siteConfig.achievements.map((achievement, index) => (
      <article class="glass glass-hover group relative overflow-hidden p-5 sm:p-6">
        <div class="absolute right-5 top-5 font-mono text-[10px] text-white/25">0{index + 1}</div>
        <div class="flex items-center gap-3 pr-10">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-r from-violet-400 to-cyan-300 shadow-[0_0_12px_#8b5cf6]"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-violet-300/75">{achievement.category}</span>
        </div>
        <h3 class="mt-5 max-w-[34rem] font-display text-base font-semibold leading-7 text-white transition-colors group-hover:text-cyan-200 sm:text-lg">{achievement.label}</h3>
        <p class="mt-3 max-w-[38rem] text-sm leading-7 text-muted">{achievement.detail}</p>
        <div class="mt-5 flex items-center justify-between gap-4 border-t border-white/[0.08] pt-4">
          <span class="font-mono text-[10px] text-white/35">{achievement.date}</span>
          <span class="rounded-full border border-cyan-300/15 bg-cyan-300/[0.06] px-2.5 py-1 font-mono text-[9px] text-cyan-200/70">{achievement.signal}</span>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-5 flex flex-col gap-3 border-l border-violet-300/30 pl-5 sm:flex-row sm:items-center sm:justify-between sm:pl-6">
    <p class="text-xs leading-6 text-white/40">证书与项目证明材料可在面试时提供核验。</p>
    <a href={`mailto:${siteConfig.social.email}`} class="font-mono text-[10px] uppercase tracking-[0.16em] text-cyan-300/75 transition-colors hover:text-cyan-200">Request details ↗</a>
  </div>
</section>
