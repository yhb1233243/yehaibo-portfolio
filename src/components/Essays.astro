---
import { getCollection } from "astro:content";
import { estimateReadingMinutes, formatEssayDate } from "../lib/essays";

const essays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const gridClass =
  essays.length === 1
    ? "lg:grid-cols-1 lg:max-w-[520px]"
    : essays.length === 2
      ? "lg:grid-cols-2"
      : "lg:grid-cols-3";
---

<section id="essays" class="pt-28 sm:pt-36">
  <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="eyebrow">03 / Notes &amp; Reflections</p>
      <h2 class="section-title mt-5">随笔</h2>
    </div>
    <p class="max-w-sm text-sm leading-7 text-muted sm:text-right">
      记录技术、成长与日常里的思考，让经过的事情留下痕迹。
    </p>
  </div>

  {
    essays.length ? (
      <div class={`mt-9 grid gap-4 ${gridClass}`}>
        {essays.map((essay, index) => (
          <a href={`/essays/${essay.id}/`} class="glass glass-hover group flex min-h-[230px] flex-col p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-[10px] text-violet-300/75">NOTE / 0{index + 1}</span>
              <span class="font-mono text-[10px] text-white/35">{estimateReadingMinutes(essay.body)} 分钟</span>
            </div>
            <h3 class="mt-6 font-display text-lg font-semibold leading-7 text-white transition-colors group-hover:text-cyan-200">{essay.data.title}</h3>
            <p class="mt-3 line-clamp-3 text-sm leading-7 text-muted">{essay.data.summary}</p>
            <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
              {essay.data.tags.slice(0, 3).map((tag) => <span class="chip">{tag}</span>)}
              <time class="ml-auto font-mono text-[9px] text-white/35" datetime={essay.data.publishedAt.toISOString()}>{formatEssayDate(essay.data.publishedAt)}</time>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="glass mt-9 flex flex-col items-start gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-violet-300/75">A quiet corner</p>
          <h3 class="mt-3 font-display text-xl font-semibold text-white">第一篇随笔，正在路上。</h3>
          <p class="mt-2 text-sm leading-7 text-muted">这里会慢慢收集关于技术、成长与日常的感悟。</p>
        </div>
        <a href="/essays/" class="btn btn-ghost shrink-0">进入随笔 <span aria-hidden="true">→</span></a>
      </div>
    )
  }

  {
    essays.length > 0 && (
      <div class="mt-6 flex justify-end">
        <a href="/essays/" class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-white/45 transition-colors hover:text-cyan-300">全部随笔 <span aria-hidden="true">↗</span></a>
      </div>
    )
  }
</section>
