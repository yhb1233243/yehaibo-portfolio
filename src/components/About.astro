---
import { siteConfig } from "../config";
---

<section id="about" class="pt-28 sm:pt-36">
  <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="eyebrow">05 / About</p>
      <h2 class="section-title mt-5">关于我</h2>
    </div>
    <p class="max-w-sm text-sm leading-7 text-muted sm:text-right">研究、工程与产品之间，保持持续迭代。</p>
  </div>

  <div class="mt-9 grid gap-5 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)]">
    <article class="glass p-6 sm:p-8">
      <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-violet-300/70">Profile / 叶海波</p>
      <p class="mt-6 max-w-2xl text-[15px] leading-8 text-muted sm:text-base sm:leading-9">{siteConfig.aboutMe}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-white/[0.08] pt-6">
        {
          siteConfig.social.email && (
            <a href={`mailto:${siteConfig.social.email}`} class="btn btn-primary">开始交流 <span aria-hidden="true">→</span></a>
          )
        }
        <span class="font-mono text-[10px] text-white/35">软件工程硕士 · 2027 届</span>
      </div>
    </article>

    <div class="space-y-5">
      <div class="glass p-6 sm:p-7">
        <p class="eyebrow">Education</p>
        <div class="mt-5 space-y-5">
          {siteConfig.education.map((edu, index) => (
            <article class="flex gap-4 border-b border-white/[0.08] pb-5 last:border-0 last:pb-0">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-violet-300/20 bg-violet-300/10 font-display text-sm font-semibold text-violet-200">{edu.school.slice(0, 1)}</span>
              <div class="min-w-0">
                <h3 class="font-display text-base font-semibold text-white">{edu.school}</h3>
                <p class="mt-1 text-xs text-cyan-300/75">{edu.degree}</p>
                <p class="mt-2 font-mono text-[10px] text-white/40">{edu.dateRange}</p>
                <ul class="mt-3 space-y-1.5">
                  {edu.achievements.map((achievement) => <li class="text-xs leading-5 text-muted">{achievement}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
